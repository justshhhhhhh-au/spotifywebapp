# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# Create app → Redirect URI: http://localhost:3000/api/spotify/callback
# (and production: https://YOUR-DOMAIN/api/spotify/callback)
# App type: Web app / SPA — enable PKCE (no client secret needed for public client)

NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: for confidential clients only
# SPOTIFY_CLIENT_SECRET=
